rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'tafareabdulmalik@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Collections ---
    
    // Reviews: Public auditing data
    // Use a unified recursive matcher for all review-related operations
    match /{path=**}/reviews/{reviewId} {
      allow get, list: if true;
      
      function isValidReview(data) {
        return isSignedIn() &&
               data.userId == request.auth.uid &&
               isValidId(data.userId) &&
               data.rating is number && data.rating >= 1 && data.rating <= 5 &&
               data.comment is string && data.comment.size() <= 2000;
      }

      allow create: if isSignedIn() && isValidReview(request.resource.data) && 
                    (request.resource.data.createdAt == request.time);
      
      allow update: if isSignedIn() && 
                    (isAdmin() || resource.data.userId == request.auth.uid) &&
                    request.resource.data.userId == resource.data.userId &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment', 'rating', 'updatedAt', 'userName'])) &&
                    (request.resource.data.updatedAt == request.time);
                    
      allow delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Admin list check
    match /admins/{userId} {
      allow read: if isSignedIn();
    }

    // Connectivity test path
    match /test/connection {
      allow read: if true;
    }

    // Connectivity test path
    match /test/connection {
      allow read: if true;
    }

    // Firms: Publicly readable, admin-only writes
    match /firms/{firmId} {
      allow read: if true;
      allow write: if isAdmin();
      // Reviews handled by the recursive block above
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, delete: if isAdmin();
    }

    // Votes
    match /votes/{voteId} {
      allow list, get: if true;
      function isValidVote(data) {
        return isSignedIn() &&
               data.userId == request.auth.uid &&
               isValidId(data.userId) &&
               isValidId(data.firmId);
      }
      allow create: if isSignedIn() && 
                    isValidVote(request.resource.data) &&
                    voteId == request.auth.uid + "_" + request.resource.data.firmId;
      allow delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Users: Private data
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      function isValidUser(data) {
        return data.keys().hasAll(['email', 'uid', 'createdAt']) &&
               data.email is string && data.email.size() <= 256 &&
               data.uid == userId;
      }

      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && 
                    isValidUser(request.resource.data) &&
                    request.resource.data.email == resource.data.email; // Email immutable
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Subscribers: Newsletter
    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string && 
                      request.resource.data.email.size() <= 256 &&
                      request.resource.data.createdAt == request.time;
      allow read, list, delete: if isAdmin();
    }
  }
}
