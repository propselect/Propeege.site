{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "A beauty or spa service offered by the salon.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Hair", "Skincare", "Nails", "Spa", "Special"] },
        "description": { "type": "string" },
        "duration": { "type": "string" },
        "priceRange": { "type": "string" },
        "price": { "type": "number" },
        "benefit": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["name", "category", "price", "duration"]
    },
    "Booking": {
      "title": "Booking",
      "description": "An appointment booked by a client.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "serviceIds": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "staffId": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled", "completed"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "clientPhone", "serviceIds", "date", "time", "status"]
    },
    "Staff": {
      "title": "Staff",
      "description": "A stylist or therapist at the salon.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "image": { "type": "string" },
        "experience": { "type": "string" },
        "bio": { "type": "string" }
      },
      "required": ["name", "specialty"]
    },
    "Review": {
      "title": "Review",
      "description": "A client testimonial and rating.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "location": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "isVisible": { "type": "boolean" }
      },
      "required": ["clientName", "rating", "comment", "date"]
    }
  },
  "firestore": {
    "services": {
      "schema": "Service",
      "description": "Collection of all available services."
    },
    "bookings": {
      "schema": "Booking",
      "description": "Client appointment bookings."
    },
    "staff": {
      "schema": "Staff",
      "description": "Salon team members."
    },
    "reviews": {
      "schema": "Review",
      "description": "Client feedback and testimonials."
    }
  }
}
